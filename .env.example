# LiteLLM proxy (required for LLM extraction; the rest of the stack boots without it)
LITELLM_MODEL=your-model-name
LITELLM_API_KEY=sk-...
LITELLM_API_BASE=https://your-litellm-proxy.example.com/v1

# Infrastructure (compose supplies these; override for a non-docker run)
DATABASE_URL=postgresql+psycopg://ukraine:ukraine@postgis:5432/ukraine
REDIS_URL=redis://redis:6379/0

# Flask sessions — set this, or sessions die on every restart
SECRET_KEY=change-me-to-32-random-bytes

# Admin bootstrap: created on first `python scripts/create_admin.py`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public site
PUBLIC_POLL_SECONDS=90
HTTP_USER_AGENT=UkraineAggregator/1.0 (+https://your-contact-url.example)

# Algorithm tuning (PLAN §4) — safe to leave at the defaults
# DEEP_STRIKE_KM=30
# CLAIM_JOIN_KM=5
# GREY_BUFFER_KM=1.5          # radius of the grey halo around an unconfirmed sighting
# GREY_CLAIM_TTL_DAYS=7       # a sighting not repeated within this window stops painting grey
# GREY_MIN_PART_KM2=0.5       # drop derived grey slivers below this area (0 = keep all)
# CLAIM_APPLY_KM=2.0          # radius a confirmed claim paints when no settlement outline exists
# CLAIM_MAX_LOCATIONS=5       # an item naming more settlements than this is a digest, not a
#                             # report of one change: it cannot open or corroborate a claim
# GAZETTEER_MIN_SIMILARITY=0.55
# LLM_BATCH_SIZE=8            # upper bound only; batches are sized to the model context window
# LLM_MAX_BODY_CHARS=4000
# LLM_REASONING=none          # 'auto' leaves the model's chain of thought enabled
# LLM_CONTEXT_TOKENS=8192     # fallback when the proxy does not report a context window
# LLM_MAX_TOKENS=2000         # output budget reserved out of that window
# LLM_TIMEOUT_S=300
# LLM_CLAIM_STALE_MINUTES=30  # when maintenance reclaims a dead worker's extraction batch

# Extraction worker concurrency (docker-compose.loadtest.yml). Measured against the reference
# proxy: throughput peaks at 4 and degrades beyond it (latency doubles, 5xx errors appear).
# LLM_CONCURRENCY=4
